modules = ["elixir", "nodejs-20"]

[[ports]]
localPort = 4000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 34093
externalPort = 3000

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Phoenix Server"

[[workflows.workflow]]
name = "Phoenix Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mix phx.server"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
