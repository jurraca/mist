modules = ["elixir", "nodejs-20"]

[[ports]]
localPort = 4000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Phoenix Server"

[[workflows.workflow]]
name = "Phoenix Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mix deps.get && iex -S mix phx.server"

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
