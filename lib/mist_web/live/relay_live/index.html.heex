<div class="mx-auto max-w-2xl">
  <.header>
    Relays
    <:actions>
      <.link patch={~p"/relays/new"}>
        <.button>Add Relay</.button>
      </.link>
    </:actions>
  </.header>

  <div class="mt-8">
    <div id="relays" class="space-y-4">
      <div :for={{id, relay} <- @relays} id={id} class="p-4 bg-dark-secondary border border-dark-border shadow-dark rounded-lg relay-box">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-2 flex-1 min-w-0">
            <button
              class="dropdown-toggle flex items-center gap-2 text-left flex-1 min-w-0"
              phx-click={JS.toggle_class("open", to: "##{id}-details") |> JS.toggle_class("rotate-90", to: "##{id}-arrow")}
            >
              <svg id={"#{id}-arrow"} class="w-4 h-4 text-text-secondary transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
              <h3 class="font-medium text-text-primary truncate">
                <%= if relay.relay_info && Map.get(relay.relay_info, "name") do %>
                  <%= relay.relay_info["name"] %>
                <% else %>
                  <%= relay.url %>
                <% end %>
              </h3>
              <%= if relay.connected? do %>
                <span class="flex w-2 h-2 bg-neon-green rounded-full flex-shrink-0 ml-auto" title="Connected"></span>
              <% else %>
                <span class="flex w-2 h-2 bg-gray-500 rounded-full flex-shrink-0 ml-auto" title="Disconnected"></span>
              <% end %>
            </button>
          </div>
          <div class="flex items-center gap-3 flex-shrink-0">
            <%= if relay.connected? do %>
              <.link
                phx-click={JS.push("disconnect", value: %{url: relay.url})}
                data-confirm="Disconnect from this relay?"
                class="text-sm text-red-500 hover:text-red-400 transition-colors whitespace-nowrap"
              >
                Disconnect
              </.link>
            <% else %>
              <.link
                phx-click={JS.push("connect", value: %{url: relay.url})}
                class="text-sm text-neon-green hover:text-green-400 transition-colors whitespace-nowrap"
              >
                Connect
              </.link>
            <% end %>
            <.link
              phx-click={JS.push("delete", value: %{url: relay.url})}
              data-confirm="Remove this relay?"
              class="text-sm text-gray-500 hover:text-red-500 transition-colors whitespace-nowrap"
            >
              Remove
            </.link>
          </div>
        </div>

        <div id={"#{id}-details"} class="relay-details mt-3">
          <div class="pt-2 border-t border-dark-border">
            <div class="text-xs text-text-muted mb-2">
              <span class="font-medium">URL:</span> <%= relay.url %>
            </div>
            <%= if relay.relay_info do %>
              <div class="text-sm text-text-secondary">
                <ul class="space-y-1">
                  <%= for {k, v} <- relay.relay_info do %>
                    <%= if k != "name" do %>
                      <%= if is_binary(v) and v != "" do %>
                        <li class="flex items-start gap-1">
                          <span class="font-medium text-text-primary flex-shrink-0"><%= k %>:</span>
                          <span class="break-words"><%= v %></span>
                        </li>
                      <% end %>
                      <%= if is_list(v) do %>
                        <li class="flex items-start gap-1">
                          <span class="font-medium text-text-primary flex-shrink-0"><%= k %>:</span>
                          <span class="break-words"><%= Enum.join(v, ", ") %></span>
                        </li>
                      <% end %>
                    <% end %>
                  <% end %>
                </ul>
              </div>
            <% else %>
              <div class="text-sm text-text-muted">No relay information available</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal :if={@live_action == :new} id="relay-modal" show on_cancel={JS.patch(~p"/relays")}>
  <.live_component
    module={MistWeb.RelayLive.FormComponent}
    id={:new}
    title={@page_title}
    action={@live_action}
    relay={@relay}
    patch={~p"/relays"}
  />
</.modal>
