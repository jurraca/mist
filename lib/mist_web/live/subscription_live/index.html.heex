<.header>
  <span class="text-neon-green">Subscriptions</span>
  <:subtitle><span class="text-text-secondary">Create and manage Nostr relay subscriptions</span></:subtitle>
</.header>

<div class="mt-8 space-y-6">
  <div class="bg-dark-secondary border border-dark-border shadow rounded-lg p-6">
    <h3 class="text-lg font-medium mb-4 text-neon-purple">Create Subscription</h3>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-text-secondary mb-1">Relay</label>
        <select
          phx-change="select_relay"
          name="relay"
          class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
        >
          <option value="">All connected relays</option>
          <%= for relay <- @relays do %>
            <option value={relay.url} selected={@selected_relay == relay.url}>
              <%= relay.url %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-text-secondary mb-1">
          Kinds (comma-separated)
        </label>
        <input
          type="text"
          name="kinds"
          value={@kinds}
          phx-blur="update_filters"
          placeholder="1, 6, 7"
          class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
        />
        <p class="mt-1 text-sm text-text-muted">1=notes, 6=reposts, 7=reactions, 9735=zaps</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-text-secondary mb-1">
          Authors (comma-separated pubkeys)
        </label>
        <input
          type="text"
          name="authors"
          value={@authors}
          phx-blur="update_filters"
          placeholder="pubkey1, pubkey2"
          class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-text-secondary mb-1">Hashtag</label>
        <input
          type="text"
          name="hashtag"
          value={@hashtag}
          phx-blur="update_filters"
          placeholder="nostr"
          class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
        />
      </div>

      <div class="flex gap-4 pt-4">
        <button
          phx-click="subscribe"
          class="inline-flex justify-center rounded-md bg-neon-green px-4 py-2 text-sm font-semibold text-dark-primary shadow-sm hover:bg-opacity-80 transition-all"
        >
          Subscribe
        </button>
        <button
          phx-click="cancel_all"
          class="inline-flex justify-center rounded-md border border-red-600 px-4 py-2 text-sm font-semibold text-red-600 shadow-sm hover:bg-red-600 hover:text-white transition-all"
        >
          Cancel All Subscriptions
        </button>
      </div>
    </div>
  </div>

  <div class="bg-dark-secondary border border-dark-border shadow rounded-lg p-6">
    <h3 class="text-lg font-medium mb-4 text-neon-purple">Connected Relays</h3>
    <%= if @relays == [] do %>
      <p class="text-text-muted">No relays connected. Add relays in the Relays page.</p>
    <% else %>
      <ul class="divide-y divide-dark-border">
        <%= for relay <- @relays do %>
          <li class="py-3 flex justify-between items-center">
            <div>
              <p class="font-medium text-text-primary"><%= relay.url %></p>
            </div>
            <span class="inline-flex items-center rounded-full bg-neon-green/10 border border-neon-green/20 px-2.5 py-0.5 text-xs font-medium text-neon-green">
              Connected
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
