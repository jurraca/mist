<.header>
  <span class="text-neon-green">Subscriptions</span>
  <:actions>
    <button
      phx-click="new"
      class="btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all hover:scale-105"
    >
      <.icon name="hero-plus-mini" class="w-4 h-4" /> New Subscription
    </button>
  </:actions>
</.header>

<div class="mt-8 space-y-6">
  <%= if @show_form do %>
    <div class="bg-dark-secondary border border-dark-border shadow rounded-lg p-6">
      <h3 class="text-lg font-medium mb-4 text-neon-purple">
        <%= if @editing, do: "Edit Subscription", else: "New Subscription" %>
      </h3>

      <.form for={@form} phx-submit="save" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-text-secondary mb-1">
            Name <span class="text-red-500">*</span>
          </label>
          <.input
            field={@form[:name]}
            type="text"
            placeholder="My subscription"
            class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-text-secondary mb-1">
            Kinds (comma-separated)
          </label>
          <input
            type="text"
            name="subscription[kinds]"
            value={format_field(@form[:kinds].value)}
            placeholder="1, 6, 7"
            class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
          />
          <p class="mt-1 text-sm text-text-muted">1=notes, 6=reposts, 7=reactions, 9735=zaps</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-secondary mb-1">
            Authors (comma-separated pubkeys)
          </label>
          <input
            type="text"
            name="subscription[authors]"
            value={format_field(@form[:authors].value)}
            placeholder="pubkey1, pubkey2"
            class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
          />
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1">
              Since (unix timestamp)
            </label>
            <input
              type="text"
              name="subscription[since]"
              value={format_field(@form[:since].value)}
              placeholder="optional"
              class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1">
              Until (unix timestamp)
            </label>
            <input
              type="text"
              name="subscription[until]"
              value={format_field(@form[:until].value)}
              placeholder="optional"
              class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-text-secondary mb-1">
              Limit
            </label>
            <input
              type="text"
              name="subscription[limit]"
              value={format_field(@form[:limit].value)}
              placeholder="optional"
              class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-secondary mb-1">
            Tags (one per line, format: <code class="text-neon-green">key: value</code>)
          </label>
          <textarea
            name="subscription[tags_raw]"
            rows="3"
            placeholder={"t: bitcoin\np: <pubkey>"}
            class="block w-full rounded-md border-dark-border bg-dark-tertiary text-text-primary shadow-sm focus:border-neon-green focus:ring-neon-green font-mono text-sm"
          ><%= tags_to_raw(@form[:tags].value) %></textarea>
          <p class="mt-1 text-sm text-text-muted">Each line becomes a tag filter (e.g. "t: bitcoin" matches #bitcoin tagged notes).</p>
        </div>

        <div class="flex gap-4 pt-2">
          <button
            type="submit"
            class="inline-flex justify-center rounded-md bg-neon-green px-4 py-2 text-sm font-semibold text-dark-primary shadow-sm hover:bg-opacity-80 transition-all"
          >
            Save
          </button>
          <button
            type="button"
            phx-click="cancel_form"
            class="inline-flex justify-center rounded-md border border-dark-border px-4 py-2 text-sm font-semibold text-text-secondary shadow-sm hover:bg-dark-tertiary transition-all"
          >
            Cancel
          </button>
        </div>
      </.form>
    </div>
  <% end %>

  <div class="bg-dark-secondary border border-dark-border shadow rounded-lg p-6">
    <h3 class="text-lg font-medium mb-4 text-neon-purple">Saved Subscriptions</h3>

    <%= if @subscriptions == [] do %>
      <p class="text-text-muted text-sm">
        No subscriptions yet. Create one above and it will appear in the Notes feed dropdown.
      </p>
    <% else %>
      <ul class="divide-y divide-dark-border">
        <%= for sub <- @subscriptions do %>
          <li class="py-4 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-text-primary"><%= sub.name %></span>
              <div class="flex gap-2">
                <button
                  phx-click="edit"
                  phx-value-id={sub.id}
                  class="text-xs text-text-muted hover:text-neon-green transition-colors px-2 py-1 rounded border border-dark-border hover:border-neon-green"
                >
                  Edit
                </button>
                <button
                  phx-click="delete"
                  phx-value-id={sub.id}
                  data-confirm="Delete this subscription?"
                  class="text-xs text-text-muted hover:text-red-500 transition-colors px-2 py-1 rounded border border-dark-border hover:border-red-500"
                >
                  Delete
                </button>
              </div>
            </div>

            <div class="flex flex-wrap gap-3 text-xs text-text-muted">
              <%= if sub.kinds && sub.kinds != [] do %>
                <span>
                  <span class="text-text-secondary font-medium">kinds:</span>
                  <%= Enum.join(sub.kinds, ", ") %>
                </span>
              <% end %>
              <%= if sub.authors && sub.authors != [] do %>
                <span>
                  <span class="text-text-secondary font-medium">authors:</span>
                  <%= length(sub.authors) %> pubkey(s)
                </span>
              <% end %>
              <%= if sub.since do %>
                <span>
                  <span class="text-text-secondary font-medium">since:</span>
                  <%= sub.since %>
                </span>
              <% end %>
              <%= if sub.until do %>
                <span>
                  <span class="text-text-secondary font-medium">until:</span>
                  <%= sub.until %>
                </span>
              <% end %>
              <%= if sub.limit do %>
                <span>
                  <span class="text-text-secondary font-medium">limit:</span>
                  <%= sub.limit %>
                </span>
              <% end %>
              <%= if sub.tags && sub.tags != %{} do %>
                <span>
                  <span class="text-text-secondary font-medium">tags:</span>
                  <%= sub.tags |> Map.keys() |> Enum.map(&("##{&1}")) |> Enum.join(", ") %>
                </span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
