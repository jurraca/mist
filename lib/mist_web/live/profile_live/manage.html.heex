<div class="max-w-2xl mx-auto mt-8">
  <.header>
    My Profile
  </.header>

  <div
    :if={@has_local_keypair}
    class="mt-4 p-4 bg-dark-secondary border border-dark-border rounded-lg"
  >
    <p class="font-mono text-sm break-all text-text-primary">
      My pubkey:
      <code class="text-xs bg-dark-tertiary px-2 py-1 rounded text-text-secondary">
        {@pubkey}
      </code>
    </p>
  </div>

  <div
    :if={!@has_local_keypair && @pubkey}
    class="mt-4 p-4 bg-dark-secondary border border-neon-green/30 rounded-lg"
  >
    <p class="text-neon-green font-medium text-sm">Read-only mode — no private key configured</p>
    <p class="text-text-secondary text-sm mt-1">
      Viewing profile for:
      <code class="text-xs bg-dark-tertiary px-2 py-1 rounded text-text-muted break-all"><%= @pubkey %></code>
    </p>
    <p class="text-text-muted text-xs mt-2">
      To edit and publish your profile, configure <code class="text-neon-green">NOSTR_PRIVKEY</code>.
    </p>
  </div>

  <div
    :if={!@has_local_keypair && !@pubkey}
    class="mt-4 p-4 bg-dark-secondary border border-dark-border rounded-lg"
  >
    <p class="text-text-muted font-medium">No identity configured.</p>
    <p class="text-sm text-text-muted mt-1">
      <.link navigate={~p"/welcome"} class="text-neon-green hover:underline">Set your identity</.link>
      to get started.
    </p>
  </div>

  <.simple_form :if={@has_local_keypair} for={@form} phx-submit="save" class="mt-8">
    <.input field={@form["name"]} label="Name" type="text" />
    <.input field={@form["about"]} label="About" type="textarea" />
    <.input field={@form["picture"]} label="Picture URL" type="url" />
    <.input field={@form["banner"]} label="Banner URL" type="url" />
    <.input field={@form["website"]} label="Website" type="url" />
    <div class="w-20">
      <.input field={@form["bot"]} label="Is Bot?" type="checkbox" />
    </div>

    <:actions>
      <.button type="submit" phx-disable-with="Saving...">Save Profile</.button>
    </:actions>
  </.simple_form>
</div>
