<div class="mx-auto max-w-2xl">
  <.header>
    Profiles
  </.header>

  <.form for={@search_form} phx-submit="search" class="mt-4">
    <div class="flex gap-2 items-end">
      <div class="flex-1">
        <.input type="text" field={@search_form[:search_term]} placeholder="Enter nprofile, npub, or hex pubkey..." />
      </div>
      <div class="flex-shrink-0">
        <.button type="submit">Search</.button>
      </div>
    </div>
  </.form>

  <div :if={@parsed_profile} class="mt-4 p-4 bg-dark-secondary border border-dark-border rounded-lg">
    <h3 class="text-lg font-semibold text-neon-green">Search Result</h3>
    <p class="mt-2 text-text-primary"><span class="font-medium text-neon-green">Pubkey:</span> <code class="text-xs bg-dark-tertiary px-2 py-1 rounded text-text-secondary"><%= @parsed_profile.pubkey %></code></p>
    <p class="mt-1 text-text-primary"><span class="font-medium text-neon-green">Npub:</span> <code class="text-xs bg-dark-tertiary px-2 py-1 rounded text-text-secondary"><%= @parsed_profile.npub%></code></p>
    <p :if={@parsed_profile.relays != []} class="mt-1 text-text-primary">
      <span class="font-medium text-neon-green">Relays:</span> <span class="text-text-secondary"><%= @parsed_profile.relays %></span>
    </p>
    <div class="mt-3">
      <button 
        phx-click="follow" 
        phx-value-pubkey={@parsed_profile.pubkey}
        class="px-4 py-2 bg-gradient-to-r from-neon-green to-neon-purple text-dark-primary rounded hover:scale-105 transition-all font-medium"
      >
        Follow
      </button>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-semibold mb-4">Profiles you follow</h2>
    <div id="profiles" phx-update="stream" class="space-y-4">
      <div :for={{id, profile} <- @streams.profiles} id={id} class="p-4 bg-dark-secondary border border-dark-border shadow-dark rounded-lg">
        <div class="flex items-center gap-4">
          <div :if={profile.picture} class="w-12 h-12">
            <img src={profile.picture} class="w-full h-full rounded-full object-cover" alt={profile.name}/>
          </div>
          <div class="flex-1">
            <h3 class="font-medium"><%= profile.name %></h3>
            <p class="text-sm text-gray-500 break-all"><%= profile.pubkey %></p>
            <p :if={profile.about} class="mt-2 text-sm"><%= profile.about %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
