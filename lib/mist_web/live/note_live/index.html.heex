<div class="flex-1 min-h-0 flex flex-col">
  <!-- Toolbar -->
  <div class="flex items-center gap-4 flex-wrap px-4 py-2 bg-dark-secondary border-b border-dark-border">
    <!-- Subscription Filter Dropdown -->
    <form phx-change="change_subscription_filter" class="flex items-center gap-2">
      <label class="text-xs font-medium text-text-muted uppercase tracking-wider">
        Source
      </label>
      <select
        name="filter"
        class="bg-dark-tertiary border border-dark-border rounded px-3 py-1 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-neon-green"
      >
        <option value="all" selected={@subscription_filter == :all}>All Relays</option>
        <option value="single_relay" selected={@subscription_filter == :single_relay}>Single Relay</option>
        <option value="following" selected={@subscription_filter == :following}>Following</option>
        <optgroup :if={length(@follow_lists) > 0} label="Custom Lists">
          <option
            :for={list <- @follow_lists}
            value={"list:#{list.id}"}
            selected={@selected_list == list.id}
          >
            📋 {list.name}
          </option>
        </optgroup>
        <option value="hashtag" selected={@subscription_filter == :hashtag}>Hashtag</option>
        <optgroup :if={length(@saved_subscriptions) > 0} label="Subscriptions">
          <option
            :for={sub <- @saved_subscriptions}
            value={"subscription:#{sub.id}"}
            selected={@selected_subscription_id == sub.id}
          >
            🔖 {sub.name}
          </option>
        </optgroup>
      </select>
    </form>

    <!-- Relay Selector (shown when single_relay is selected) -->
    <form :if={@subscription_filter == :single_relay} phx-change="change_relay" class="flex items-center gap-2">
      <select
        name="relay_url"
        class="bg-dark-tertiary border border-dark-border rounded px-3 py-1 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-neon-green"
      >
        <option value="">Select Relay</option>
        <option :for={relay_url <- @available_relays} value={relay_url} selected={@selected_relay == relay_url}>
          {relay_url}
        </option>
      </select>
    </form>

    <!-- Hashtag Input (shown when hashtag is selected) -->
    <form :if={@subscription_filter == :hashtag} phx-change="change_hashtag" class="flex items-center gap-2">
      <input
        phx-debounce="500"
        name="hashtag"
        type="text"
        placeholder="#bitcoin"
        value={@hashtag_filter}
        class="bg-dark-tertiary border border-dark-border rounded px-3 py-1 text-sm text-text-primary focus:outline-none focus:ring-2 focus:ring-neon-green w-32"
      />
    </form>

    <!-- View Mode Toggle -->
    <div class="flex bg-dark-tertiary rounded-lg p-1">
      <button
        phx-click="toggle_view"
        phx-value-mode="list"
        class={[
          "px-3 py-1 rounded text-sm transition-all",
          (@view_mode == :list && "bg-neon-green text-dark-primary") ||
            "text-text-secondary hover:text-text-primary"
        ]}
      >
        List
      </button>
      <button
        phx-click="toggle_view"
        phx-value-mode="graph"
        class={[
          "px-3 py-1 rounded text-sm transition-all",
          (@view_mode == :graph && "bg-neon-green text-dark-primary") ||
            "text-text-secondary hover:text-text-primary"
        ]}
      >
        Graph
      </button>
    </div>

    <.link patch={~p"/notes/new"} class="ml-auto">
      <button class="btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all hover:scale-105">
        <.icon name="hero-plus-mini" class="w-4 h-4" /> New Note
      </button>
    </.link>
  </div>

  <!-- List view. Always in the DOM (hidden via CSS when in graph mode):
      the notes stream must have its container present at mount so the
      initial DB-loaded items render, and stream inserts from the 250ms
      batch flush always have a target even while the graph is showing.
      Unlike the graph view, this side is fully server-managed — no
      phx-update="ignore" — so LiveView can safely toggle its class. -->
  <div class={["flex-1 min-h-0 overflow-y-auto", @view_mode != :list && "hidden"]}>
    <div class="mx-auto max-w-4xl px-4 py-8">
      <div :if={@notes_empty_message} class="text-center py-16 text-text-muted">
        <p class="text-sm">{@notes_empty_message}</p>
      </div>

      <div id="notes" phx-update="stream" phx-hook="NoteCountUpdater" class="space-y-3">
        <div :for={{dom_id, note} <- @streams.notes} id={dom_id} class="note-card">
          <div class="flex items-start gap-3">
            <div class="shrink-0">
              <%= if note.picture do %>
                <img src={note.picture} referrerpolicy="no-referrer" class="w-10 h-10 rounded-full object-cover" alt="" />
              <% else %>
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-green to-neon-purple flex items-center justify-center text-dark-primary font-bold text-sm shrink-0">
                  {(note.author || "?") |> String.slice(0, 1) |> String.upcase()}
                </div>
              <% end %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2 mb-1">
                <span class="text-sm font-medium text-neon-green truncate">{note.author || String.slice(note.pubkey, 0, 12)}</span>
                <span class="text-xs text-text-muted font-mono shrink-0">
                  <%= if note.created_at do %>
                    {note.created_at}
                  <% else %>
                    Just now
                  <% end %>
                </span>
              </div>
              <%= if note.reply_to do %>
                <div class="flex items-center gap-1.5 text-xs text-text-muted mb-1">
                  <span>↩ replying to</span>
                  <a
                    href={"https://njump.me/#{note.reply_to}"}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={note.reply_to}
                    class="text-neon-green hover:underline font-mono"
                  >
                    {String.slice(note.reply_to, 0, 10)}…
                  </a>
                </div>
              <% end %>
              <%!-- Server renders plain text as a safe fallback; the
                  NoteContent hook enhances it client-side with the same
                  link/image/entity rendering the sidebar uses. --%>
              <p
                id={"note-content-#{note.id}"}
                phx-hook="NoteContent"
                data-content={note.content}
                class="text-text-primary text-sm leading-relaxed whitespace-pre-wrap break-words space-y-2"
              >{note.content}</p>
              <div class="flex items-center gap-4 text-xs text-text-muted mt-2 interaction-stats">
                <%= if Map.get(note, :reaction_count, 0) > 0 do %>
                  <span>❤️ {Map.get(note, :reaction_count, 0)}</span>
                <% end %>
                <%= if Map.get(note, :boost_count, 0) > 0 do %>
                  <span>🔄 {Map.get(note, :boost_count, 0)}</span>
                <% end %>
                <%= if Map.get(note, :zap_amount, 0) > 0 do %>
                  <span class="text-yellow-400">⚡ {Map.get(note, :zap_amount, 0)} sats</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Graph view: fills the remaining viewport; the right column is a static
      sidebar that renders the hovered/pinned note client-side. The sidebar
      is phx-update="ignore" so LiveView never resets its JS-toggled state,
      and has a FIXED width so its content can never resize the graph. -->
  <div :if={@view_mode == :graph} class="flex-1 min-h-0 flex">
    <%!-- phx-update="ignore": the graph's DOM is owned by d3. Without this,
        any server re-render would patch this (server-side empty) container
        and wipe the client-created SVG. All updates flow via push_event. --%>
    <div
      id="graph-container"
      class="flex-1 min-w-0"
      phx-hook="NetworkGraph"
      phx-update="ignore"
    >
    </div>

    <aside id="graph-sidebar" phx-update="ignore" class="w-[360px] shrink-0 border-l border-dark-border bg-dark-secondary overflow-y-auto">
      <div class="p-4">
        <div id="graph-sidebar-content">
          <p id="graph-sidebar-placeholder" class="text-sm text-text-muted">
            Hover a node to read the note.
          </p>
          <div id="graph-sidebar-single" class="hidden space-y-3">
            <div class="flex items-center gap-3">
              <img
                id="graph-sidebar-avatar"
                class="hidden w-10 h-10 rounded-full object-cover bg-dark-tertiary border border-dark-border"
                alt=""
                referrerpolicy="no-referrer"
              />
              <div
                id="graph-sidebar-avatar-placeholder"
                class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-green to-neon-purple flex items-center justify-center text-dark-primary font-bold shrink-0"
              ></div>
              <div class="min-w-0">
                <div id="graph-sidebar-author" class="text-sm font-medium text-neon-green truncate"></div>
                <div id="graph-sidebar-time" class="text-xs text-text-secondary font-mono"></div>
              </div>
            </div>
            <div class="bg-dark-tertiary rounded-lg p-3 border border-dark-border">
              <div id="graph-sidebar-body" class="text-text-primary text-sm leading-relaxed whitespace-pre-wrap break-words space-y-2"></div>
            </div>
            <div id="graph-sidebar-stats" class="flex items-center gap-4 text-xs text-text-muted"></div>
            <code id="graph-sidebar-id" class="block text-xs text-text-muted"></code>
          </div>
          <div id="graph-sidebar-thread" class="hidden space-y-2"></div>
        </div>
      </div>
    </aside>
  </div>
</div>

<.modal :if={@live_action in [:new]} id="note-modal" show on_cancel={JS.patch(~p"/notes")}>
  <%= if @has_local_keypair do %>
    <.live_component
      module={MistWeb.NoteLive.FormComponent}
      id={:new}
      title={@page_title}
      action={@live_action}
      note={%Event{}}
      patch={~p"/notes"}
    />
  <% else %>
    <div class="p-6 text-center space-y-4">
      <.icon name="hero-lock-closed" class="w-12 h-12 text-text-muted mx-auto" />
      <h3 class="text-lg font-semibold text-text-primary">Read-only mode</h3>
      <p class="text-text-secondary text-sm">
        No private key configured. Publishing notes requires a private key set via the
        <code class="text-neon-green">NOSTR_PRIVKEY</code> environment variable.
      </p>
      <.link patch={~p"/notes"} class="inline-block mt-2 text-sm text-text-muted hover:text-neon-green transition-colors">
        Go back
      </.link>
    </div>
  <% end %>
</.modal>
