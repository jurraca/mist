
<div class="mx-auto max-w-2xl">
  <.header>
    Notes
    <:actions>
      <.link patch={~p"/notes/new"}>
        <.button>New Note</.button>
      </.link>
    </:actions>
  </.header>

  <div class="mt-8">
    <div id="notes" phx-update="stream" class="space-y-4">
      <div :for={{dom_id, note} <- @streams.notes} id={dom_id} class="p-4 bg-white shadow rounded-lg">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-gray-500">ID:</span>
            <span class="text-sm font-mono break-all"><%= note.id %></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-gray-500">Pubkey:</span>
            <span class="text-sm font-mono break-all"><%= note.pubkey %></span>
          </div>
          <p class="mt-2 text-gray-700 whitespace-pre-wrap"><%= note.content %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal :if={@live_action in [:new]} id="note-modal" show on_cancel={JS.patch(~p"/notes")}>
  <.live_component
    module={MistWeb.NoteLive.FormComponent}
    id={:new}
    title={@page_title}
    action={@live_action}
    note={%Event{}}
    patch={~p"/notes"}
  />
</.modal>
